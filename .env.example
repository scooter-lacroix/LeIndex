# LeIndex Environment Configuration Template
#
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the real `.env` file — it is gitignored.
# Secrets should be provided via environment variables or a secrets manager
# (e.g., GitHub Actions secrets, AWS Secrets Manager, HashiCorp Vault).

# ── Database Configuration ──────────────────────────────────────────
# Local SQLite database path (relative to project root or absolute)
LOCAL_DB=local.db

# ── Turso / libSQL Remote Storage (optional) ────────────────────────
# Uncomment and fill in for remote vector storage
# TURSO_URL=libsql://your-db.turso.io
# TURSO_AUTH=your_turso_auth_token

# ── Runtime Settings ────────────────────────────────────────────────
# Backtrace detail level for Rust panics (0=minimal, 1=short, full=verbose)
RUST_BACKTRACE=1

# Log level filter (error, warn, info, debug, trace)
RUST_LOG=info

# ── MCP Server Settings ─────────────────────────────────────────────
# Port for the MCP stdio/HTTP server (if using HTTP transport)
# MCP_PORT=3000

# ── Neural Search (ONNX) ────────────────────────────────────────────
# Model directory (defaults to ~/.leindex/models/)
# LEINDEX_MODEL_DIR=~/.leindex/models/

# ── Observability (optional) ────────────────────────────────────────
# OTLP collector endpoint for OpenTelemetry trace export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus metrics endpoint
# LEINDEX_METRICS_ENDPOINT=0.0.0.0:9090

# Sentry DSN for error tracking
# SENTRY_DSN=https://yourkey@sentry.io/yourproject

# ── Feature Flags ───────────────────────────────────────────────────
# Set to "true" to enable (see src/feature_flags.rs for all options)
# LEINDEX_FEATURE_NEURAL_SEARCH=false
# LEINDEX_FEATURE_REMOTE_EMBEDDINGS=false
# LEINDEX_FEATURE_CROSS_LANGUAGE=false
# LEINDEX_FEATURE_EXPERIMENTAL_HNSW=false
# LEINDEX_FEATURE_STREAMING_MCP=true
# LEINDEX_FEATURE_GLOBAL_AUTO_SYNC=true
