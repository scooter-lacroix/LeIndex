diff a/.github/workflows/release.yml b/.github/workflows/release.yml	(rejected hunks)
@@ -505,6 +505,38 @@ jobs:
           # explaining the layout, the install.sh path, the leindex setup
           # command, and the ORT discovery chain so a user who extracts
           # the archive directly can get to a working install.
+          #
+          # The quick start and bin/ layout are platform-specific: Windows
+          # bundles ship only leindex.exe (no daemon, no POSIX cp). The
+          # fragments are written with QUOTED heredocs so `$HOME` reaches
+          # the reader literally instead of being expanded on the runner,
+          # then spliced into the main (unquoted, $VERSION-expanding)
+          # document via $(cat ...).
+          STEP1_FRAG="$RUNNER_TEMP/install-step1.txt"
+          if [ "${{ matrix.asset_name }}" = "windows-x86_64" ]; then
+            LAYOUT_BINS="    bin/        leindex.exe (worker mode: leindex --internal-embed-worker)"
+            cat > "$STEP1_FRAG" <<'FRAG'
+          1. Add this directory to your PATH, or copy bin\leindex.exe into
+             a directory that already is. The shared daemon is not shipped
+             on Windows; leindex sessions always run in-process.
+FRAG
+          else
+            LAYOUT_BINS='    bin/        leindex binary (worker mode: leindex --internal-embed-worker)
+            bin/leindexd  shared per-user daemon'
+            cat > "$STEP1_FRAG" <<'FRAG'
+          1. Add this directory to your PATH. Copy BOTH binaries —
+             bin/leindex AND bin/leindexd — together into the same
+             directory (e.g. ~/.cargo/bin); leindex looks for leindexd
+             next to itself:
+
+               cp bin/leindex bin/leindexd ~/.cargo/bin/
+               export PATH="$HOME/.cargo/bin:$PATH"
+
+             Without leindexd beside it, every `leindex mcp` session runs
+             its own inline server (higher memory per editor/session)
+             instead of sharing one daemon per user.
+FRAG
+          fi
           cat > "$BUNDLE_DIR/INSTALL.txt" <<EOF
           LeIndex $VERSION — ${{ matrix.asset_name }}
           ==========================================
